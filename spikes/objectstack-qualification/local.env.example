# TP-02 local environment — EXAMPLE, synthetic throwaway values only.
# Copy to local/.env (done by scripts/bootstrap-infra.sh). Every value here is
# local-loopback disposable test data, never a real credential.

# Platform PostgreSQL (ObjectStack managed datasource)
PLATFORM_PG_USER=objectstack
PLATFORM_PG_PASSWORD=tp02-platform-synthetic-pw
PLATFORM_PG_DB=objectstack

# External source PostgreSQL (owner login + narrow read-only login)
SOURCE_PG_OWNER=eam_owner
SOURCE_PG_OWNER_PASSWORD=tp02-source-owner-synthetic-pw
SOURCE_PG_DB=eam_source
SOURCE_PG_RO_USER=tp02_ro
SOURCE_PG_RO_PASSWORD=tp02-ro-synthetic-pw

# ObjectStack qualification host (rendered into local/app.env by the script)
TP02_APP_PORT=3100
