{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wu-xiaochen/trusted-agent-platform/contracts/business-task.schema.json",
  "title": "M0 Static Task Declaration Prototype",
  "$comment": "Temporary static-only prototype used by the repository baseline. It is not the product's authoritative ontology, authorization, runtime, or publish contract. TP-02/TP-04 determine how qualified ObjectStack metadata is extended; do not build a competing object/action schema from this prototype.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "lifecycle", "sources", "objects", "rules", "actions", "views"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["draft", "published"] },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "objects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "views": { "type": "array", "items": { "$ref": "#/$defs/view" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["http", "postgres", "document"] },
        "verification": { "enum": ["unverified", "verified"] }
      }
    },
    "object": {
      "type": "object", "additionalProperties": false, "required": ["id", "sourceId"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" } }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "status": { "enum": ["proposed", "confirmed", "unknown", "conflict"] },
        "owner": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceId", "objectId", "enabled", "mode", "ruleIds", "idempotency", "reconciliation", "approval"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" }, "objectId": { "$ref": "#/$defs/id" },
        "enabled": { "type": "boolean" }, "mode": { "enum": ["draft-only", "confirm", "auto"] },
        "ruleIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "idempotency": { "enum": ["source-key", "business-key", "none"] }, "reconciliation": { "enum": ["source-query", "manual"] },
        "approval": { "enum": ["human-confirmation", "business-approval", "policy"] }, "automationPolicyRef": { "$ref": "#/$defs/id" }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["object-summary", "table", "form", "action-confirmation", "status", "evidence"] },
        "objectId": { "$ref": "#/$defs/id" }, "actionId": { "$ref": "#/$defs/id" }
      }
    },
    "view": {
      "type": "object", "additionalProperties": false, "required": ["id", "components"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "components": { "type": "array", "items": { "$ref": "#/$defs/component" } } }
    }
  }
}
